{
  "version": 2,
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/server.js": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "dist/app.js"
    },
    "api/health.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/health/dependencies.js": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/api/health/dependencies", "dest": "/api/health/dependencies.js" },
    { "src": "/api/health", "dest": "/api/health.js" },
    { "src": "/api/(.*)", "dest": "/api/server.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
